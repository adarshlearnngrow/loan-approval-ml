# Credit Risk Predictor - Environment Variables
# Copy this file to .env and fill in your values

# ══════════════════════════════════════════════════════════════════════════════
# MLflow Configuration
# ══════════════════════════════════════════════════════════════════════════════
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ══════════════════════════════════════════════════════════════════════════════
# OpenAI Configuration (Optional - for AI-powered reports)
# ══════════════════════════════════════════════════════════════════════════════
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Model to use for report generation
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens for report generation
OPENAI_MAX_TOKENS=800

# Temperature for response creativity (0.0 - 1.0)
OPENAI_TEMPERATURE=0.7
