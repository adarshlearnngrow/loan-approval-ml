# Ignore Python cache and environment files
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore VS Code settings
.vscode/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore virtual environments
venv/
env/
loan_approval_env/

# Ignore data and output files
*.sqlite3
*.db
*.log
*.csv
*.xlsx

# MLflow local tracking (too large for git, use models/ instead)
mlruns/
mlartifacts/

# Raw datasets (too large for git)
Datasets/

# Exported model IS tracked (small, portable)
!models/
!models/model.pkl
!models/model_info.json
!models/experiment_runs.json

# Ignore secrets and credentials
*.key
*.pem
*.ppk
*.key
id_rsa
id_rsa.pub
creditriskmodelling_key
creditriskmodelling_key.pub

